# Cache headers for the static production site (Cloudflare Workers Assets).
#
# Without this file Workers Assets sends `public, max-age=0, must-revalidate`
# for everything. The edge still caches (cf-cache-status: HIT), but every
# browser is told to revalidate every asset on every page view, so a returning
# visitor pays a round trip per image before anything paints.
#
# Rules are matched in order and the FIRST match wins.

# Next's own build output is content-hashed: the filename changes whenever the
# bytes do, so it can be cached forever and never revalidated.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Design assets live at stable, author-chosen paths, so they are deliberately
# NOT immutable: replacing photo-1.jpg with different bytes has to be able to
# reach people. A week of hard caching with a day of stale-while-revalidate
# means a repeat visit costs nothing and a replaced image is picked up on the
# next visit after that, in the background.
#
# If an image ever needs to change *immediately*, rename it. That is the price
# of stable paths, and it is cheaper than making every visitor revalidate.
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Deliberately NO Cache-Control catch-all.
#
# Workers Assets MERGES every rule whose pattern matches, it does not stop at
# the first. A catch-all setting Cache-Control would append to the rules above
# and make browsers honour the most restrictive max-age (breaking image cache).
# HTML already defaults to revalidate; that is correct for published pages.
#
# CSP on `/*` is fine: it merges as an additional header, not Cache-Control.

# Turnstile widget (public forms). Without these hosts the challenge is blocked.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://accp.burojazz.com; font-src 'self' data:; connect-src 'self' https://accp.burojazz.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://accp.burojazz.com; object-src 'none'
