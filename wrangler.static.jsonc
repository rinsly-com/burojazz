{
  // ===========================================================================
  // PRODUCTION — fully static site. No `main`, no D1, no runtime: just the
  // static export in out/ served from Cloudflare's edge (Workers Static Assets).
  // Built from published content on accp. Deploy: pnpm run deploy:static
  // ===========================================================================
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "burojazz",
  "compatibility_date": "2025-08-15",
  "assets": {
    "directory": "out",
    // Next's static export emits 404.html and trailing-slash directory pages.
    // public/_redirects and public/_headers are copied into this directory.
    // Wrangler reads them as asset metadata (it does not serve the files).
    // Nothing here excludes them: no assets.exclude, and no .assetsignore.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
